# Copy to .env (never commit .env).
# Signing key for release APKs. Keep the .jks file and these passwords backed up:
# without them you cannot ship updates that install over the existing app.
GRIFO_KEYSTORE=.signing/grifo-release.jks
GRIFO_KEYSTORE_PASSWORD=
GRIFO_KEY_ALIAS=grifo
GRIFO_KEY_PASSWORD=

# JDK 21 for Gradle (Capacitor 8). Leave empty if JAVA_HOME already points to JDK 21.
JAVA21_HOME=C:/Users/kayf/scoop/apps/temurin21-jdk/current
